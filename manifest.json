{
  "manifest_version": 3,
  "name": "Lucid Reader — a better PDF reader",
  "short_name": "Lucid Reader",
  "version": "1.3.0",
  "description": "Reflows PDFs into a real reading view: your fonts, read-along pacing, auto-scroll, RSVP, bionic text and focus modes.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open in Lucid Reader (right-click to turn Lucid off)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "open-reader": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Open the current PDF in Lucid Reader"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["reader/*", "vendor/*", "fonts/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
